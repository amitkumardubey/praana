{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Built-in Tool Catalog §6.3 input.",
  "properties": {
    "byte_offset": {
      "default": 0,
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "result_id": {
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    }
  },
  "required": [
    "result_id"
  ],
  "type": "object"
}
