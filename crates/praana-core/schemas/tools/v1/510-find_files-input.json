{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "max_results": {
      "default": 100,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "mode": {
      "anyOf": [
        {
          "enum": [
            "fuzzy",
            "glob"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "path": {
      "default": ".",
      "type": "string"
    },
    "query": {
      "type": "string"
    }
  },
  "required": [
    "query"
  ],
  "type": "object"
}
