{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cancelled": {
      "type": "boolean"
    },
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "exit_code": {
      "format": "int32",
      "type": [
        "integer",
        "null"
      ]
    },
    "signal": {
      "type": [
        "string",
        "null"
      ]
    },
    "stderr": {
      "type": "string"
    },
    "stdout": {
      "type": "string"
    },
    "timed_out": {
      "type": "boolean"
    }
  },
  "required": [
    "cancelled",
    "duration_ms",
    "stderr",
    "stdout",
    "timed_out"
  ],
  "type": "object"
}
