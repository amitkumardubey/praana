{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "paths": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "file",
              "directory",
              "symlink",
              "other"
            ],
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "score_milli": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "path"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "paths",
    "truncated"
  ],
  "type": "object"
}
