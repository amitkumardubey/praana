{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cursor": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "include_retracted": {
      "default": false,
      "type": "boolean"
    },
    "kinds": {
      "default": [],
      "items": {
        "enum": [
          "task",
          "decision",
          "constraint",
          "note",
          "error"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "limit": {
      "default": 50,
      "type": "integer"
    },
    "statuses": {
      "default": [],
      "items": {
        "enum": [
          "todo",
          "in_progress",
          "blocked",
          "done",
          "cancelled",
          "active",
          "superseded",
          "satisfied",
          "waived",
          "open",
          "resolved",
          "ignored"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "tiers": {
      "default": [],
      "items": {
        "enum": [
          "active",
          "soft",
          "hard"
        ],
        "type": "string"
      },
      "type": "array"
    }
  },
  "type": "object"
}
