{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Built-in Tool Catalog §6.3 success value.",
  "properties": {
    "source": {
      "additionalProperties": false,
      "properties": {
        "byte_offset": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "complete": {
          "type": "boolean"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "continuation": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "byte_offset": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "result_id": {
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                }
              },
              "required": [
                "byte_offset",
                "result_id"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_line": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "event_id": {
          "anyOf": [
            {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "result_id": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "returned_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_field": {
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "event",
            "artifact",
            "summary_segment",
            "state"
          ],
          "type": "string"
        },
        "start_line": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "type": "string"
        },
        "total_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total_lines": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "turn_id": {
          "anyOf": [
            {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "byte_offset",
        "complete",
        "content_sha256",
        "end_line",
        "result_id",
        "returned_bytes",
        "source_field",
        "source_kind",
        "start_line",
        "text",
        "total_bytes",
        "total_lines"
      ],
      "type": "object"
    }
  },
  "required": [
    "source"
  ],
  "type": "object"
}
