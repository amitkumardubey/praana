{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_insensitive": {
      "default": false,
      "type": "boolean"
    },
    "context_lines": {
      "default": 2,
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "exclude_globs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "include_globs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "max_results": {
      "default": 100,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "path": {
      "default": ".",
      "type": "string"
    },
    "pattern": {
      "type": "string"
    }
  },
  "required": [
    "pattern"
  ],
  "type": "object"
}
