---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  current?: "home" | "reference" | "architecture" | "concepts";
}

const {
  title,
  description = "PRAANA is an open-source terminal coding agent that runs on your machine and works with the model provider you already use: Anthropic, OpenAI, Google, DeepSeek, Groq, OpenRouter, Amazon Bedrock, Ollama and more. MIT licensed.",
  keywords = "terminal coding agent, CLI coding agent, AI coding agent, open source coding agent, local-first AI, bring your own model, Ollama, OpenRouter, Bun, TypeScript",
  current,
} = Astro.props;

const pageTitle =
  current === "home"
    ? "PRAANA — open-source terminal coding agent"
    : `${title} · PRAANA`;

const siteUrl = Astro.site ?? new URL("https://amitkumardubey.github.io/praana/");
const canonical = new URL(Astro.url.pathname, siteUrl).href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "PRAANA",
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "Terminal coding agent",
  operatingSystem: "Linux, macOS, Windows (Bun ≥ 1.4)",
  description:
    "Open-source terminal coding agent that runs on your machine and works with the model provider you choose.",
  url: "https://amitkumardubey.github.io/praana/",
  downloadUrl: "https://www.npmjs.com/package/praana",
  softwareHelp: "https://amitkumardubey.github.io/praana/reference/",
  license: "https://opensource.org/licenses/MIT",
  programmingLanguage: "TypeScript",
  keywords,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: "Amit Kumar Dubey" },
  codeRepository: "https://github.com/amitkumardubey/praana",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Amit Kumar Dubey" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#2e3440" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap.xml`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Outfit:wght@500;600;700&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PRAANA" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a class="brand" href={import.meta.env.BASE_URL}>PRAANA</a>
        <a href={import.meta.env.BASE_URL} aria-current={current === "home" ? "page" : undefined}>Home</a>
        <a href={`${import.meta.env.BASE_URL}reference/`} aria-current={current === "reference" ? "page" : undefined}>Reference</a>
        <a href={`${import.meta.env.BASE_URL}architecture/`} aria-current={current === "architecture" ? "page" : undefined}>Architecture</a>
        <a href={`${import.meta.env.BASE_URL}concepts/`} aria-current={current === "concepts" ? "page" : undefined}>Concepts</a>
        <a href="https://github.com/amitkumardubey/praana">GitHub</a>
        <a href="https://www.npmjs.com/package/praana">npm</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      MIT ·
      <a href="https://github.com/amitkumardubey/praana">GitHub</a> ·
      <a href="https://www.npmjs.com/package/praana">npm</a> ·
      <a href="https://github.com/amitkumardubey/praana/blob/main/CHANGELOG.md">Changelog</a>
    </footer>
  </body>
</html>
