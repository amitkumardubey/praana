{
  "name": "@praana/natives",
  "version": "0.13.0",
  "description": "Native capability layer for PRAANA (napi-rs / Bun Node-API)",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "praana-natives",
    "packageName": "@praana/natives",
    "targets": [
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --manifest-path ../../crates/praana-natives/Cargo.toml --output-dir . --esm",
    "build:debug": "napi build --platform --manifest-path ../../crates/praana-natives/Cargo.toml --output-dir . --esm",
    "artifacts": "napi artifacts",
    "create-npm-dirs": "napi create-npm-dirs",
    "test:smoke": "bun run smoke.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.5"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/amitkumardubey/praana.git",
    "directory": "packages/praana-natives"
  },
  "publishConfig": {
    "access": "public"
  }
}
